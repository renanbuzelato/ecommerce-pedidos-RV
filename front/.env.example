# Deixe VAZIO para usar a API simulada (dados mockados no navegador, sem servidor).
# Preencha com a URL do back-end Spring Boot para consumir a API real:
# VITE_API_URL=http://localhost:8080/api
VITE_API_URL=

# Atraso artificial (ms) da API simulada, para enxergar os indicadores de carregamento
VITE_MOCK_DELAY=400
